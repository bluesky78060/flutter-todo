# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Pre-install hook to fix app_links (iOS 26 crash issue)
pre_install do |installer|
  installer.pod_targets.each do |pod|
    if pod.name == 'app_links'
      def pod.build_type
        Pod::BuildType.static_library
      end
    end
  end
end

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # iOS 최소 버전
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # Swift 6 완전 차단
      config.build_settings['SWIFT_VERSION'] = '5.0'
      config.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'minimal'
      config.build_settings['ENABLE_EXPERIMENTAL_SWIFT_6'] = 'NO'

      # 경고 → 에러 승격 차단
      config.build_settings['TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      config.build_settings['SWIFT_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      config.build_settings['CLANG_WARNINGS_AS_ERRORS'] = 'NO'
    end
  end

  # Fix build cycle for Widget Extension
  # Move "Embed Foundation Extensions" BEFORE CocoaPods scripts to break the cycle
  project_path = 'Runner.xcodeproj'
  project = Xcodeproj::Project.open(project_path)

  project.targets.each do |target|
    if target.name == 'Runner'
      embed_extensions_phase = target.build_phases.find { |phase|
        phase.respond_to?(:name) && phase.name == 'Embed Foundation Extensions'
      }

      embed_frameworks_phase = target.build_phases.find { |phase|
        phase.respond_to?(:name) && phase.name == 'Embed Frameworks'
      }

      if embed_extensions_phase && embed_frameworks_phase
        # Remove from current position
        target.build_phases.delete(embed_extensions_phase)

        # Insert right after "Embed Frameworks"
        embed_frameworks_index = target.build_phases.index(embed_frameworks_phase)
        if embed_frameworks_index
          target.build_phases.insert(embed_frameworks_index + 1, embed_extensions_phase)
        end
      end

      # Also clear inputPaths from Thin Binary to break Info.plist cycle
      target.build_phases.each do |phase|
        if phase.respond_to?(:name) && phase.name == 'Thin Binary'
          phase.input_paths.clear if phase.respond_to?(:input_paths)
        end
      end
    end
  end

  project.save
end