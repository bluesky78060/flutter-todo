# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
._*
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment files
.env
.env.local
.env.production

# Android signing keys (DO NOT COMMIT!)
android/key.properties
android/app/key.properties
android/local.properties
*.keystore
*.jks
*.pem
upload-keystore.jks
android/app/upload-keystore.jks
keystore_backup/

# Release binaries (too large for GitHub)
*.apk
*.aab
app-release*.apk
app-release*.aab

# Web build artifacts with secrets
web/index.html

# Node.js dependencies
node_modules/
package-lock.json
ios/build/

# Gradle 빌드 산출물 — 위쪽 /build/ 는 저장소 루트만 덮는다
# (android/.gradle 은 android/.gitignore 가 이미 잡는다)
android/build/
android/app/build/

# 에이전트·도구 실행 상태. .omc/skills 만 커밋 대상이다.
# 상위를 통째로 제외하면 하위를 negation 으로 되살릴 수 없어 .omc/* 로 쓴다.
**/.omc/*
!**/.omc/skills/
**/graft/.cache/
docs/.bkit-memory.json
docs/.pdca-status.json
